# Copia este fichero a .env.local y rellena los valores.
# .env.local esta en .gitignore y es el que lee docker-compose (env_file).

# --- Formularios (obligatorio para que booking y contacto funcionen) ---
# Bot de Telegram al que se reenvian los envios de los dos formularios.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Spotify (opcional) ---
# Sin estas dos variables la seccion "Sus lanzamientos" muestra el reproductor
# de perfil del artista (canciones mas escuchadas). Con ellas se pinta ademas
# la rejilla de albumes y singles con caratula, ano y numero de temas.
#
# Se sacan de https://developer.spotify.com/dashboard -> Create app
# (Redirect URI puede ser cualquiera, no se usa el flujo de usuario).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
