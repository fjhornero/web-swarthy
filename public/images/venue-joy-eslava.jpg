<script type="text/javascript">
(function($) { 
    function setup_collapsible_submenus() {
        // mobile menu
        $('#mobile_menu .menu-item-has-children > a').after('<span class="menu-closed"></span>');
        $('#mobile_menu .menu-item-has-children > a').each(function() {
            $(this).next().next('.sub-menu').toggleClass('hide',1000);
        });
        $('#mobile_menu .menu-item-has-children > a + span').on('click', function(event) {
            event.preventDefault();
            $(this).toggleClass('menu-open');
            $(this).next('.sub-menu').toggleClass('hide',1000);
        });
    }
       
    $(window).load(function() {
        setTimeout(function() {
            setup_collapsible_submenus();
        }, 700);
    });
  
})(jQuery);
</script>

<script>
jQuery(document).ready(function($) {
    var $videoBoxes = $('.dm-autoplay-btn .et_pb_video_box');
    
    if ($videoBoxes.length !== 0) {
        $videoBoxes.find('video')
            .prop('muted', true)
            .prop('loop', true)
            .prop('playsInline', true);
        
        $videoBoxes.each(function() {
            this.querySelector('video').play();
        });
    }
});
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const days = [
    "sunday",
    "monday",
    "tuesday",
    "wednesday",
    "thursday",
    "friday",
    "saturday"
  ];

  const todayClass = "day-" + days[new Date().getDay()];

  document.querySelectorAll("." + todayClass).forEach(el => {
    el.classList.add("day-active");
  });
});
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const dayRows = document.querySelectorAll(".day-content");
    const dayIdByIndex = ["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"];

    // SETUP: Move ID to a data-attribute to stop browser from jumping
    dayRows.forEach(row => {
        if (row.id) {
            row.setAttribute('data-day', row.id.toLowerCase());
            row.removeAttribute('id'); // This kills the "weird scroll" jump
        }
    });

    function activateDay(dayId) {
        if (!dayId) return;
        
        // 1. Show/Hide Rows using data-attribute
        dayRows.forEach(row => {
            const rowDay = row.getAttribute('data-day');
            if (rowDay === dayId.toLowerCase()) {
                row.style.setProperty('display', 'block', 'important');
                row.classList.add("is-active");
            } else {
                row.style.setProperty('display', 'none', 'important');
                row.classList.remove("is-active");
            }
        });

        // 2. Update Menu Styles
        document.querySelectorAll('.day-menu a').forEach(a => {
            const href = a.getAttribute("href") || "";
            a.classList.toggle("is-active", href.toLowerCase().includes("#" + dayId.toLowerCase()));
        });

        // 3. Update URL silently
        history.replaceState(null, null, "#" + dayId);
    }

    // Initial load
    let initialDay = window.location.hash.replace("#", "").toLowerCase();
    if (!dayIdByIndex.includes(initialDay)) {
        initialDay = dayIdByIndex[new Date().getDay()];
    }
    activateDay(initialDay);

    // Handle Clicks
    document.addEventListener("click", function (e) {
        const anchor = e.target.closest('.day-menu a');
        if (!anchor) return;

        const href = anchor.getAttribute("href");
        if (href && href.includes("#")) {
            const dayId = href.split("#")[1].toLowerCase();
            
            if (dayIdByIndex.includes(dayId)) {
                e.preventDefault();
                e.stopImmediatePropagation(); // Hard stop for Divi's scroll scripts
                
                activateDay(dayId);

                // --- MOBILE CLOSE ---
                const mobileNav = document.querySelector(".mobile_nav");
                if (mobileNav && mobileNav.classList.contains("opened")) {
                    const toggle = mobileNav.querySelector(".mobile_menu_bar");
                    if (toggle) toggle.click();
                }
            }
        }
    }, true);
});
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {
  if (window.location.hash) {
    history.replaceState(null, "", window.location.pathname);
  }
});
</script>
